<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Installer for Box Launcher (WiX v4/v5). Build: see .github/workflows/windows.yml -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Box Launcher" Manufacturer="mightyy-duck" Version="$(Version)"
           UpgradeCode="6f1c2d1e-8a3b-4c57-9e0a-5b7d2c9a41f3" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Box Launcher is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Box Launcher">
        <Component Id="AppExe" Guid="3b0f5a52-62f4-4a0e-8d52-2f4c7b1e9a10">
          <File Id="BoxLauncherExe" Source="target\release\boxlauncher.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="a7d4c9e1-1b62-4f0b-b3a8-0c5e6d7f8a21">
        <Shortcut Id="StartMenuLink" Name="Box Launcher" Description="Install, update and open the Box apps"
                  Target="[INSTALLFOLDER]boxlauncher.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\BoxLauncher" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Box Launcher" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
